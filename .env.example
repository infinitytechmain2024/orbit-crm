# Supabase (Required)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Backend API (Required for production - set to your Render backend URL)
# For local development: http://localhost:8000
# For production: https://orbit-crm-backend.onrender.com
VITE_API_URL=https://orbit-crm-backend.onrender.com

# Lead Generator Service (Optional - separate service on port 8090)
VITE_LEAD_GEN_URL=http://localhost:8090

# OpenAI-compatible remote LLM endpoint. Keep provider secrets server-side.
VITE_OLLAMA_URL=https://integrate.api.nvidia.com/v1
VITE_LLM_MODEL=openai/gpt-oss-120b

# Backend (for local development)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
EXPECTED_SUPABASE_PROJECT_REF=qavfajsflzbefgegkwjt

OLLAMA_BASE_URL=https://integrate.api.nvidia.com/v1
OLLAMA_MODEL=openai/gpt-oss-120b
OLLAMA_API_KEY=

WHISPER_MODEL=tiny
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=ru

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_URL=

OPENMANUS_HEADLESS=true
OPENMANUS_SLOW_MO=100
OPENMANUS_TIMEOUT=300

NOTION_API_KEY=
NOTION_DATABASE_ID=

CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","https://*.vercel.app"]

# OpenClaw Gateway (server-only, never expose to frontend)
# Local: http://127.0.0.1:18789
# Render Blueprint can also inject internal host:port via fromService.
OPENCLAW_URL=http://127.0.0.1:18789
OPENCLAW_GATEWAY_TOKEN=generate-with-openssl-rand-hex-32
OPENCLAW_WEBHOOK_TOKEN=generate-with-openssl-rand-hex-32
OPENCLAW_REQUEST_TIMEOUT=120.0
OPENCLAW_DAILY_ACTION_LIMIT=100
OPENCLAW_MAX_CONTEXT_RECORDS=20

# Vercel serverless (set in Vercel dashboard — NEVER with VITE_ prefix, server-only)
NVIDIA_API_KEY=nvapi-your-key-here
# Hosted Whisper transcription; local development falls back to the FastAPI backend.
GROQ_API_KEY=gsk-your-key-here
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
NVIDIA_MODEL=nemotron-3-ultra
# NVIDIA_MODEL options: nemotron-3-ultra, openai/gpt-oss-120b, meta/llama-3.1-70b-instruct, etc.
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Optional provider fallbacks. Keep all provider keys server-only.
# Set OPENAI_API_KEY to enable the assistant/chat flow to use OpenAI directly.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
GROQ_MODEL=
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Capability-tagged models; keep every provider secret in its server-only variable above.
# AI_MODEL_CONFIGS_JSON=[{"provider":"nvidia","model_name":"org/model","capabilities":["coding","reasoning"],"priority":100,"max_retries":1}]
AI_MODEL_CONFIGS_JSON=
AI_WORKFLOW_AUTORUN=true
AI_WORKFLOW_WORKER_ENABLED=true
AI_WORKFLOW_WORKER_CONCURRENCY=4
AI_WORKFLOW_POLL_INTERVAL_SECONDS=1.5
# How often worker 0 fails abandoned jobs that exhausted their attempts.
AI_WORKFLOW_SWEEP_INTERVAL_SECONDS=60
AI_WORKFLOW_MAX_QA_REVISIONS=2
# QA only: a configured model-name substring used to simulate failure and verify fallback.
AI_WORKFLOW_TEST_FAIL_MODEL=
# Server-only URL of the FastAPI service. In Vercel, set BACKEND_URL explicitly
# to your Render backend public URL.
# Prefer the workflow-specific name; RENDER_BACKEND_URL remains supported for existing deployments.
AI_WORKFLOW_BACKEND_URL=https://orbit-crm-backend.onrender.com
RENDER_BACKEND_URL=https://orbit-crm-backend.onrender.com
INTERNAL_API_TOKEN=generate-with-openssl-rand-hex-32

# Local self-hosted development provider. This token is intentionally
# separate from INTERNAL_API_TOKEN and OpenClaw credentials.
SELFDEV_PROVIDER_TOKEN=generate-with-openssl-rand-hex-32
SELFDEV_PROVIDER_LEASE_SECONDS=90
SELFDEV_BACKEND_URL=http://host.docker.internal:8000
SELFDEV_PROVIDER_NAME=dmytro-mac-docker
SELFDEV_ORGANIZATION_ID=00000000-0000-0000-0000-000000000000
SELFDEV_REPOSITORY_PATH=/workspace/orbit-crm
SELFDEV_EXECUTION_ENABLED=false

# Mail provider (server-only; never use VITE_AGENTMAIL_API_KEY)
AGENTMAIL_API_KEY=server_only_agentmail_key
AGENTMAIL_INBOX=inbox_address_or_id
AGENTMAIL_WEBHOOK_SECRET=whsec_secret_from_agentmail_console
AGENTMAIL_ORGANIZATION_ID=uuid_организации_для_этого_inbox

# Stripe (Backend - Server Only, NEVER with VITE_ prefix)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret

# Stripe (Frontend - Safe to expose)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# Self-development autopilot (Backend - Server Only, NEVER with VITE_ prefix)
# Fine-grained PAT: Contents (R/W) + Pull requests (R/W) minimum. Never commit the real value.
GITHUB_TOKEN=github_pat_your_fine_grained_token
GITHUB_REPO=owner/test-repo-name
