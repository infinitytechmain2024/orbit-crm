# Supabase (Required)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Backend API (Required for production - set to your Cloudflare Tunnel URL)
# For local development: http://localhost:8000
# For production: https://your-tunnel.trycloudflare.com
VITE_API_URL=http://localhost:8000

# Lead Generator Service (Optional - separate service on port 8090)
VITE_LEAD_GEN_URL=http://localhost:8090

# Ollama / LLM (Optional - for direct browser LLM calls)
VITE_LLM_PROVIDER=ollama
VITE_OLLAMA_URL=http://localhost:11434/v1
VITE_LLM_MODEL=llama3.2

# Backend (for local development)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2
OLLAMA_API_KEY=ollama

WHISPER_MODEL=tiny
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=ru

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_URL=

OPENMANUS_HEADLESS=true
OPENMANUS_SLOW_MO=100
OPENMANUS_TIMEOUT=300

NOTION_API_KEY=
NOTION_DATABASE_ID=

CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","https://*.vercel.app"]

# Vercel serverless (set in Vercel dashboard — NEVER with VITE_ prefix, server-only)
NVIDIA_API_KEY=nvapi-your-key-here
# Hosted Whisper transcription; local development falls back to the FastAPI backend.
GROQ_API_KEY=gsk-your-key-here
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Capability-tagged models; keep provider secrets in NVIDIA_API_KEY only.
# AI_MODEL_CONFIGS_JSON=[{"provider":"nvidia","model_name":"org/model","capabilities":["coding","reasoning"],"priority":100,"max_retries":1}]
AI_MODEL_CONFIGS_JSON=
AI_WORKFLOW_AUTORUN=true
# QA only: a configured model-name substring used to simulate failure and verify fallback.
AI_WORKFLOW_TEST_FAIL_MODEL=
# Server-only URL of the FastAPI service. Prefer the workflow-specific name;
# RENDER_BACKEND_URL remains supported for existing deployments.
AI_WORKFLOW_BACKEND_URL=http://127.0.0.1:8000
RENDER_BACKEND_URL=
INTERNAL_API_TOKEN=generate-with-openssl-rand-hex-32
