# Supabase (Required)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Backend API (Required for production - set to your Cloudflare Tunnel URL)
# For local development: http://localhost:8000
# For production: https://your-tunnel.trycloudflare.com
VITE_API_URL=http://localhost:8000

# Lead Generator Service (Optional - separate service on port 8090)
VITE_LEAD_GEN_URL=http://localhost:8090

# Ollama / LLM (Optional - for direct browser LLM calls)
VITE_LLM_PROVIDER=ollama
VITE_OLLAMA_URL=http://localhost:11434/v1
VITE_LLM_MODEL=llama3.2

# OpenAI Fallback (Optional)
VITE_OPENAI_API_KEY=

# Backend (for local development)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2
OLLAMA_API_KEY=ollama

WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=ru

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_URL=

OPENMANUS_HEADLESS=true
OPENMANUS_SLOW_MO=100
OPENMANUS_TIMEOUT=300

NOTION_API_KEY=
NOTION_DATABASE_ID=

CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","https://*.vercel.app"]

# Vercel serverless (set in Vercel dashboard — NEVER with VITE_ prefix, server-only)
NVIDIA_API_KEY=nvapi-your-key-here
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
RENDER_BACKEND_URL=https://orbit-crm-backend.onrender.com
INTERNAL_API_TOKEN=generate-with-openssl-rand-hex-32