# Local credentials for the autopilot's browser self-test.
#
# Copy to `.env.e2e.local` and fill in a DEDICATED test account — never a real
# operator account. `.env.e2e.local` is git-ignored (`.env.*` rule) and must stay
# that way: these values are read straight into the test process environment and
# are never written to a file, an argv, a log line, or a pull request.

# Turns the browser self-test on. Off by default so an unconfigured environment
# reports "skipped" instead of a vacuous pass.
AUTOPILOT_E2E_ENABLED=true

# Dedicated Supabase test user (create it once in the local/staging project).
AUTOPILOT_E2E_EMAIL=autopilot-test@example.local
AUTOPILOT_E2E_PASSWORD=replace-me

# Where Playwright drives the app. Deliberately not 8080: the verification run
# boots the freshly cloned copy, and reusing your own dev server on 8080 would
# verify the wrong code.
AUTOPILOT_E2E_BASE_URL=http://localhost:8099

# Anon/publishable key for the frontend build under test. This is the PUBLIC
# key — the service-role key must never be given to a browser.
AUTOPILOT_E2E_SUPABASE_ANON_KEY=

# Self review of the real git diff (one extra model call per run).
AUTOPILOT_SELF_REVIEW_ENABLED=true
