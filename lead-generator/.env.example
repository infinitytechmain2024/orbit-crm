# Ollama (Llama 3.2)
OLLAMA_BASE_URL=https://integrate.api.nvidia.com/v1
OLLAMA_MODEL=openai/gpt-oss-120b

# Supabase (Lead storage + sessions)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DEFAULT_ORGANIZATION_ID=your-default-org-id

# OpenManus (Playwright browser automation)
OPENMANUS_HEADLESS=true
OPENMANUS_SLOW_MO=100
OPENMANUS_TIMEOUT=300

# Server
LEAD_GEN_HOST=0.0.0.0
LEAD_GEN_PORT=8090

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
